PORT=4000
NODE_ENV=development

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# АНХААР: service_role key-ийг зөвхөн энд (backend) хадгална. Frontend-д хэзээ ч бүү хий.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend-ийн хаяг (таслалаар хэд хэдийг зааж болно)
CORS_ORIGIN=http://localhost:5173

# И-мэйлгүй бүртгэсэн оюутанд <оюутны код>@<домэйн> хаяг автоматаар үүснэ
STUDENT_EMAIL_DOMAIN=student.ikhzasag.edu.mn

# --- Mobile App (заавал биш) ---
# Expo "Enhanced push security" асаасан бол: https://expo.dev → Account → Access tokens
EXPO_ACCESS_TOKEN=
# "Өнөөдөр"-ийг тооцох цагийн бүс (ирц, багшийн dashboard)
APP_TIMEZONE=Asia/Ulaanbaatar
# Цахим оюутны үнэмлэхийн QR гарын үсгийн түлхүүр (заавал биш, хоосон бол service key-ээс гаргана)
# Үүсгэх: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDENT_CARD_SECRET=
# Санхүү: автомат төлбөрийн сануулга (10:00–18:00). false бол унтарна
FINANCE_AUTO_REMIND=true

# --- Долоо хоногийн тайлан (и-мэйл) ---
# Даваа гараг бүр 09:00-д удирдлагад илгээнэ
WEEKLY_REPORT=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Gmail бол "App password" (2FA асаалттай үед Google Account → Security → App passwords)
SMTP_PASS=
SMTP_FROM="Их Засаг <noreply@ikhzasag.edu.mn>"
# Таслалаар. Хоосон бол management, super_admin эрхтэй хэрэглэгчдийн и-мэйл
REPORT_RECIPIENTS=
