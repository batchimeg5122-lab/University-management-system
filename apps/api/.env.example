PORT=4000
NODE_ENV=development

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
# АНХААР: service_role key-ийг зөвхөн энд (backend) хадгална. Frontend-д хэзээ ч бүү хий.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend-ийн хаяг (таслалаар хэд хэдийг зааж болно)
CORS_ORIGIN=http://localhost:5173

# И-мэйлгүй бүртгэсэн оюутанд <оюутны код>@<домэйн> хаяг автоматаар үүснэ
STUDENT_EMAIL_DOMAIN=student.ikhzasag.edu.mn
