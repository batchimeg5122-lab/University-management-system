# Өгөгдлийн эх үүсвэр:
#   mock     — туршилтын өгөгдөл (backend, Supabase хэрэггүй)
#   api      — Express API (apps/api) → Supabase   ← санал болгох
#   supabase — Supabase руу шууд (RLS), backend-гүй
VITE_DATA_SOURCE=api

# apps/api-ийн хаяг
# Хоосон бол хуудсыг нээсэн хостыг ашиглана (localhost эсвэл LAN IP):4000/api
VITE_API_URL=

# Зөвхөн нэвтрэлт болон realtime мэдэгдэлд ашиглана (ANON key)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
