# ------------------------------------------------------------
# Их Засаг Mobile — тохиргоо
# Энэ файлыг .env болгон хуулж бөглөнө:  copy .env.example .env
# Өөрчилсний дараа: npx expo start -c   (cache цэвэрлэж асаана)
# ------------------------------------------------------------

# Express API (apps/api). Утсан дээр "localhost" АЖИЛЛАХГҮЙ —
# компьютерийн LAN IP-г бичнэ (ipconfig → IPv4 Address).
# Хоосон орхивол Expo dev серверийн IP-г автоматаар ашиглана.
EXPO_PUBLIC_API_URL=

# Supabase — зөвхөн URL ба ANON key. SERVICE_ROLE_KEY-г энд ХЭЗЭЭ Ч бүү бич!
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Web систем — тодорхойлолт, үнэмлэхийн QR энэ хаяг руу заана.
# Хоосон бол компьютерийн IP-г автоматаар ашиглана (http://<IP>:5173)
EXPO_PUBLIC_WEB_URL=

# (Заавал биш) EAS projectId — push notification. `npx eas init` хийвэл app.json-д автоматаар бичигдэнэ
EXPO_PUBLIC_EAS_PROJECT_ID=
